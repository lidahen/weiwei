DATABASE_URL=mysql+aiomysql://root:123456@localhost:3306/twelvet-fast
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=your-api-key-here
AI_MODEL=deepseek-chat

# RAG Embedding（OpenAI 兼容接口，SiliconFlow 提供免费 bge-m3）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_MODEL=BAAI/bge-m3

# 上传文件静态资源前缀（UPLOAD 文档解析时用于拼接相对路径）
STATIC_BASE_URL=https://your-bucket.oss-cn-beijing.aliyuncs.com

# ── AI 音乐：商汤 senseaudio（文生歌 / 平台音色翻唱 / AI 写词） ──
SENSEAUDIO_BASE_URL=https://api.senseaudio.cn
SENSEAUDIO_API_KEY=
SENSEAUDIO_MUSIC_MODEL=senseaudio-music-2.0-260626
SENSEAUDIO_TIMEOUT=30
SENSEAUDIO_POLL_INTERVAL=5
SENSEAUDIO_POLL_MAX_WAIT=300

# ── AI 音乐：硅基流动（用户上传样本训练克隆音色 + 用克隆音色合成 TTS） ──
# 复用现有 TTS_BASE_URL / TTS_API_KEY / EMBEDDING_API_KEY 之一即可
SILICONFLOW_VOICE_CLONE_MODEL=IndexTeam/IndexTTS-2
SILICONFLOW_VOICE_API_KEY=
SILICONFLOW_VOICE_MIN_DURATION_S=10
SILICONFLOW_VOICE_MAX_DURATION_S=60

# ── AI 音乐：配额 ──
MUSIC_QUOTA_SONG_COST=5
MUSIC_QUOTA_LYRICS_COST=1
MUSIC_QUOTA_VOICE_TRAIN_COST=3
MUSIC_QUOTA_VOICE_TRAIN_DAILY_LIMIT=1

# ── Java 内部接口（Agent 的写操作必须经 Java，禁止直写业务表）──
# 背景：Agent 原先直接 INSERT trade_order（列清单无 tenant_id），会落到 DB 的
#       NOT NULL DEFAULT 1，在 tenant.enabled=true 下造成跨租户订单混入。
# 服务间调用统一经 Java；下方令牌必须与 Java 侧一致。
JAVA_BASE_URL=http://localhost:8080
# 需与 Java 的 twelvet.internal.token（环境变量 INTERNAL_API_TOKEN）取值一致。
# 留空时 Java 侧按"失败关闭"拒绝内部接口：Agent 下单会明确报错，绝不回退为直写数据库。
INTERNAL_API_TOKEN=

# ── creation 域（AI 创作工作台；不配置则回退到上面的 AI/EMBEDDING key 与本地存储）──
# ASR 语音识别（OpenAI 兼容 /audio/transcriptions；为空时复用 TTS/EMBEDDING key）
ASR_API_KEY=
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
# 创作产物工作目录（成片/分镜产物，OSS 未配置时经 /ai/creation/media/* 访问）
CREATION_WORK_DIR=./data/creation
# 字幕字体名（容器内为 fonts-noto-cjk；Windows 开发可改 Microsoft YaHei）
CREATION_SUBTITLE_FONT=Noto Sans CJK SC

# WhisperX 词级对齐（可选增强）：本地 pip install whisperx 后生效，未安装自动回退句级字幕。
# TTS 干声对齐用 base 档足够；RTX 5060 8G 本地建议 CREATION_ALIGN_DEVICE=cuda（float16）
# CREATION_ALIGN_ENABLED=true
# CREATION_ALIGN_MODEL=base
# CREATION_ALIGN_LANGUAGE=zh
# CREATION_ALIGN_DEVICE=auto   # auto|cuda|cpu
# CREATION_ALIGN_COMPUTE_TYPE=auto  # auto→cuda:float16 / cpu:int8
