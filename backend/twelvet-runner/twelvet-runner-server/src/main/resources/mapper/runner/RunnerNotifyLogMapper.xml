<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.twelvet.runner.server.mapper.RunnerNotifyLogMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="log.id">
        INSERT INTO twelve_runner_notify_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="tenantId != null">tenant_id,</if>
            <if test="log.taskId != null">task_id,</if>
            <if test="log.action != null">action,</if>
            <if test="log.senderId != null">sender_id,</if>
            <if test="log.receiverId != null">receiver_id,</if>
            <if test="log.content != null">content,</if>
            <if test="log.channel != null">channel,</if>
            <if test="log.status != null">status,</if>
            <if test="log.errorMsg != null">error_msg,</if>
            create_time
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="tenantId != null">#{tenantId},</if>
            <if test="log.taskId != null">#{log.taskId},</if>
            <if test="log.action != null">#{log.action},</if>
            <if test="log.senderId != null">#{log.senderId},</if>
            <if test="log.receiverId != null">#{log.receiverId},</if>
            <if test="log.content != null">#{log.content},</if>
            <if test="log.channel != null">#{log.channel},</if>
            <if test="log.status != null">#{log.status},</if>
            <if test="log.errorMsg != null">#{log.errorMsg},</if>
            NOW()
        </trim>
    </insert>

</mapper>
