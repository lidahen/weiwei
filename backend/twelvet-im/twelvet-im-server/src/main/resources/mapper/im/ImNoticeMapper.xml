<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.twelvet.im.server.mapper.ImNoticeMapper">

    <resultMap type="ImNotice" id="NoticeResult">
        <id property="noticeId" column="notice_id"/>
        <result property="userId" column="user_id"/>
        <result property="type" column="type"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="isRead" column="is_read"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectNoticeListByUserId" resultMap="NoticeResult">
        SELECT notice_id, type, title, content, is_read, create_time
        FROM im_notice
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
        LIMIT 50
    </select>

    <insert id="insertNotice" parameterType="ImNotice" useGeneratedKeys="true" keyProperty="noticeId">
        INSERT INTO im_notice (user_id, type, title, content, is_read, create_time)
        VALUES (#{userId}, #{type}, #{title}, #{content}, 0, sysdate())
    </insert>

</mapper>
