<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.twelvet.im.server.mapper.ImMessageMapper">

    <resultMap type="ImMessage" id="MessageResult">
        <id property="msgId" column="msg_id"/>
        <result property="convId" column="conv_id"/>
        <result property="senderId" column="sender_id"/>
        <result property="receiverId" column="receiver_id"/>
        <result property="type" column="type"/>
        <result property="content" column="content"/>
        <result property="imageUrl" column="image_url"/>
        <result property="status" column="status"/>
        <result property="recalled" column="recalled"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectMessageListByConvId" resultMap="MessageResult">
        SELECT msg_id, conv_id, sender_id, receiver_id, type, content,
               image_url, status, COALESCE(recalled, 0) AS recalled, create_time
        FROM im_message
        WHERE conv_id = #{convId}
        <if test="tenantId != null">AND tenant_id = #{tenantId}</if>
        ORDER BY create_time ASC
        LIMIT #{limit}
    </select>

    <insert id="insertMessage" parameterType="ImMessage" useGeneratedKeys="true" keyProperty="msgId">
        INSERT INTO im_message (conv_id, sender_id, receiver_id, type, content, status, create_time
        <if test="tenantId != null">, tenant_id</if>)
        VALUES (#{convId}, #{senderId}, #{receiverId}, #{type}, #{content}, 'sent', sysdate()
        <if test="tenantId != null">, #{tenantId}</if>)
    </insert>

</mapper>
