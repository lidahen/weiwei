<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>twelvet-ai</artifactId>
        <groupId>com.twelvet</groupId>
        <version>3.5.4</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>twelvet-ai-server</artifactId>

    <description>AI 模块服务实现 - 代理到 Python FastAPI 服务</description>

    <dependencies>
        <!-- twelvet-ai-api -->
        <dependency>
            <groupId>com.twelvet</groupId>
            <artifactId>twelvet-ai-api</artifactId>
        </dependency>

        <!-- framework -->
        <dependency>
            <groupId>com.twelvet</groupId>
            <artifactId>twelvet-framework-core</artifactId>
        </dependency>
        <!-- 商业化第三轮：AI 计量读 SysTenantMapper（与 product-server 同模式，单向依赖无循环） -->
        <dependency>
            <groupId>com.twelvet</groupId>
            <artifactId>twelvet-system-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.twelvet</groupId>
            <artifactId>twelvet-framework-datasource</artifactId>
        </dependency>
        <dependency>
            <groupId>com.twelvet</groupId>
            <artifactId>twelvet-framework-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.twelvet</groupId>
            <artifactId>twelvet-framework-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.twelvet</groupId>
            <artifactId>twelvet-framework-log</artifactId>
        </dependency>
        <dependency>
            <groupId>com.twelvet</groupId>
            <artifactId>twelvet-framework-jdbc</artifactId>
        </dependency>

        <!-- WebFlux for SSE proxy (AiChatController) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- IM 推送能力（日报生成后经 IImService 发 system 消息，同 runner 的做法） -->
        <dependency>
            <groupId>com.twelvet</groupId>
            <artifactId>twelvet-im-server</artifactId>
            <version>${twelvet.version}</version>
        </dependency>

    </dependencies>

</project>
