<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.twelvet.ai.server.mapper.AiUsageMapper">

    <resultMap type="com.twelvet.ai.api.domain.AiUsageDaily" id="AiUsageDailyResult">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="statDate" column="stat_date"/>
        <result property="calls" column="calls"/>
        <result property="promptTokens" column="prompt_tokens"/>
        <result property="completionTokens" column="completion_tokens"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectDaily" resultMap="AiUsageDailyResult">
        select id, tenant_id, stat_date, calls, prompt_tokens, completion_tokens, update_time
        from ai_usage_daily
        where tenant_id = #{tenantId} and stat_date &gt;= #{startDate}
        order by stat_date asc
    </select>

</mapper>
