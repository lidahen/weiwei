<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.twelvet.exchange.server.mapper.ExchangeOrderLogMapper">

    <resultMap id="LogResult" type="com.twelvet.exchange.server.domain.ExchangeOrderLog">
        <id property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="operatorId" column="operator_id"/>
        <result property="action" column="action"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- 多参数方法：keyProperty 必须带参数名，否则 MyBatis 无法回填自增主键 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="log.id">
        INSERT INTO twelve_exchange_order_log (order_id, operator_id, action, remark, create_time, tenant_id)
        VALUES (#{log.orderId}, #{log.operatorId}, #{log.action}, #{log.remark}, NOW(), #{tenantId})
    </insert>

    <select id="selectByOrderId" resultMap="LogResult">
        SELECT id, order_id, operator_id, action, remark, create_time
        FROM twelve_exchange_order_log
        WHERE order_id = #{orderId}
        <if test="tenantId != null">AND tenant_id = #{tenantId}</if>
        ORDER BY create_time ASC
    </select>

</mapper>
